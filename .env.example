# Base de datos PostgreSQL. En producción usar la connection string *pooled*
# (Neon la llama "Pooled connection"): cada invocación serverless abre su propia
# conexión y una base sin pooler se queda sin slots.
DATABASE_URL="postgresql://usuario:password@host/base?sslmode=require"

# Auth.js — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# En producción, el dominio real con https y sin barra final. La usan las vueltas
# de Mercado Pago y también el SEO (canónicas, OpenGraph, sitemap y robots): si
# queda apuntando a localhost, el sitemap y las canónicas salen publicados con esa
# URL y los buscadores los descartan.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Si el sitio puede aparecer en buscadores. Apagado salvo que valga exactamente
# "true": mientras tanto todas las páginas salen con `noindex` y el robots.txt no
# anuncia el sitemap.
#
# Se enciende recién cuando el contenido esté aprobado —hoy quedan textos
# marcados como provisorios en Quiénes somos y Contacto, y la política de cambios
# y devoluciones sin revisión legal—. Olvidarse de encenderlo se nota; olvidarse
# de apagarlo deja esos textos en el índice de Google.
SITE_INDEXABLE="false"

# Usuario administrador inicial que crea `npx prisma db seed`
ADMIN_EMAIL="admin@miniholz.com.ar"
ADMIN_PASSWORD=""
ADMIN_NAME="Administración MiniHolz"

# Mercado Pago — credenciales de https://www.mercadopago.com.ar/developers > Tus integraciones.
# Sin ACCESS_TOKEN el checkout directamente no ofrece la opción de pagar con tarjeta.
# Empezar con las credenciales de PRUEBA (TEST-...) y recién después pasar a producción.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# "Clave secreta" de la configuración de Webhooks. Obligatoria en producción:
# sin ella no se puede distinguir una notificación real de una inventada.
# Admite VARIAS separadas por coma, porque la clave es por aplicación: los pagos
# de prueba los crea la app del usuario de prueba que MP provisiona solo, con su
# propia clave, y los reales la app propia con otra. Ver docs/mercadopago.md.
MERCADOPAGO_WEBHOOK_SECRET=""

# Datos de tienda (default inicial; luego editables desde /admin/configuracion)
WHATSAPP_NUMBER="549XXXXXXXXXX"
BANK_ACCOUNT_INFO="CBU/Alias/Titular/Banco"

# Subida de archivos. Sin token se escribe en `public/uploads/` (solo sirve en
# local: en Vercel el disco es efímero). Lo inyecta solo Vercel al conectar un
# Blob store al proyecto, así que en este archivo va vacío.
BLOB_READ_WRITE_TOKEN=""
# Tope por archivo. No subirlo de 4: Vercel rechaza los request de más de
# 4,5 MB antes de que lleguen a la app.
UPLOADS_MAX_SIZE_MB="4"

# Correo (Resend). RESEND_API_KEY y RESEND_EMAIL_DOMAIN las inyecta Vercel al
# conectar la integración del Marketplace, así que acá van vacías.
RESEND_API_KEY=""
RESEND_EMAIL_DOMAIN="miniholz.com.ar"

# Remitentes. El dominio no tiene casilla —no hay MX en la raíz—, por eso el
# remitente avisa que no se responde.
EMAIL_FROM="MiniHolz <no-responder@miniholz.com.ar>"
EMAIL_ADMIN_FROM="MiniHolz · Avisos <administracion@miniholz.com.ar>"

# A dónde va el "Responder" de los clientes. No necesita ser del dominio: puede
# ser un Gmail ya existente, y es lo que evita que una respuesta rebote.
EMAIL_REPLY_TO="miniholz.mdp@gmail.com"

# Destinatario de los avisos internos: pedidos nuevos, comprobantes y consultas.
# Si se omite, se usa EMAIL_REPLY_TO.
EMAIL_ADMIN="miniholz.mdp@gmail.com"
