# Base de datos PostgreSQL. En producción usar la connection string *pooled*
# (Neon la llama "Pooled connection"): cada invocación serverless abre su propia
# conexión y una base sin pooler se queda sin slots.
DATABASE_URL="postgresql://usuario:password@host/base?sslmode=require"

# Auth.js — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# En producción, el dominio real con https y sin barra final.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Usuario administrador inicial que crea `npx prisma db seed`
ADMIN_EMAIL="admin@miniholz.com.ar"
ADMIN_PASSWORD=""
ADMIN_NAME="Administración MiniHolz"

# Mercado Pago — credenciales de https://www.mercadopago.com.ar/developers > Tus integraciones.
# Sin ACCESS_TOKEN el checkout directamente no ofrece la opción de pagar con tarjeta.
# Empezar con las credenciales de PRUEBA (TEST-...) y recién después pasar a producción.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# "Clave secreta" de la configuración de Webhooks. Obligatoria en producción:
# sin ella no se puede distinguir una notificación real de una inventada.
# Admite VARIAS separadas por coma, porque la clave es por aplicación: los pagos
# de prueba los crea la app del usuario de prueba que MP provisiona solo, con su
# propia clave, y los reales la app propia con otra. Ver docs/mercadopago.md.
MERCADOPAGO_WEBHOOK_SECRET=""

# Datos de tienda (default inicial; luego editables desde /admin/configuracion)
WHATSAPP_NUMBER="549XXXXXXXXXX"
BANK_ACCOUNT_INFO="CBU/Alias/Titular/Banco"

# Subida de archivos. Sin token se escribe en `public/uploads/` (solo sirve en
# local: en Vercel el disco es efímero). Lo inyecta solo Vercel al conectar un
# Blob store al proyecto, así que en este archivo va vacío.
BLOB_READ_WRITE_TOKEN=""
# Tope por archivo. No subirlo de 4: Vercel rechaza los request de más de
# 4,5 MB antes de que lleguen a la app.
UPLOADS_MAX_SIZE_MB="4"
